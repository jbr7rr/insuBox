
config IB_BLE_COMM
	bool "BLE communicaiton service"
	depends on BT
	help
	  Enable BLE communication service, which controls the BLE communication. (connecting, disconnecting, etc.)


if IB_BLE_COMM

config IB_BT_MAX_CLIENT_CONNECTIONS
	int "Maximum number of BLE client connections"
	default 1
	range 1 5
	help
	  Set the maximum number of BLE client connections. This is the maximum number of devices that can be connected to the device at the same time.

config BT_RX_STACK_SIZE
	default 4096

config BT_LONG_WQ_STACK_SIZE
	default 4096

endif # IB_BLE_COMM