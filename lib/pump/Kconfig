menu "Libraries"

config IB_PUMP
	bool "Insulin Pump"
    help
        This option enables support for insulin pumps.
        Note: This module is concerned with the insulin delivery, 
        certain parts of a hardware pump such as HMI will reside in their own modules.

if IB_PUMP

choice IB_PUMP_TYPE
    prompt "Insulin Pump Type"
    default IB_PUMP_VIRTUAL

config IB_PUMP_VIRTUAL
    bool "Virtual Insulin Pump"
    help
        This option enables support for a virtual insulin pump.

endchoice

endif

rsource "medtrum_bt/Kconfig"
rsource "insubox/Kconfig"

endmenu
